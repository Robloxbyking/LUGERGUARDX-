local function updateTeleportPlayersList(container, statusLabel)
    for _, child in pairs(container:GetChildren()) do
        child:Destroy()
    end
    
    local yOffset = 0
    local playerCount = 0
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            playerCount = playerCount + 1
            
            local playerFrame = Instance.new("Frame")
            playerFrame.Size = UDim2.new(1, -20, 0, 35)
            playerFrame.Position = UDim2.new(0, 0, 0, yOffset)
            playerFrame.BackgroundColor3 = Color3.fromRGB(25, 30, 35)
            playerFrame.BackgroundTransparency = 0.4
            playerFrame.BorderSizePixel = 0
            playerFrame.Parent = container
            
            local frameCorner = Instance.new("UICorner")
            frameCorner.CornerRadius = UDim.new(0, 6)
            frameCorner.Parent = playerFrame
            
            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, -70, 1, 0)
            nameLabel.Position = UDim2.new(0, 12, 0, 0)
            nameLabel.Text = player.Name
            nameLabel.TextColor3 = Color3.fromRGB(210, 215, 225)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Font = Enum.Font.Gotham
            nameLabel.TextSize = 13
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.Parent = playerFrame
            
            local teleportPlayerBtn = Instance.new("TextButton")
            teleportPlayerBtn.Size = UDim2.new(0, 55, 0, 26)
            teleportPlayerBtn.Position = UDim2.new(1, -62, 0, 4.5)
            teleportPlayerBtn.Text = "TP"
            teleportPlayerBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            teleportPlayerBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 180)
            teleportPlayerBtn.BackgroundTransparency = 0.2
            teleportPlayerBtn.BorderSizePixel = 0
            teleportPlayerBtn.Font = Enum.Font.GothamBold
            teleportPlayerBtn.TextSize = 12
            teleportPlayerBtn.Parent = playerFrame
            
            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 4)
            btnCorner.Parent = teleportPlayerBtn
            
            teleportPlayerBtn.MouseEnter:Connect(function()
                teleportPlayerBtn.BackgroundTransparency = 0.4
                teleportPlayerBtn.TextColor3 = Color3.fromRGB(0, 200, 255)
            end)
            
            teleportPlayerBtn.MouseLeave:Connect(function()
                teleportPlayerBtn.BackgroundTransparency = 0.2
                teleportPlayerBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            end)
            
            teleportPlayerBtn.MouseButton1Click:Connect(function()
                local success = teleportToPlayer(player)
                if statusLabel then
                    if success then
                        statusLabel.Text = (currentLang == "ru") and "✓ Телепортирован к " .. player.Name or "✓ Teleported to " .. player.Name
                        statusLabel.TextColor3 = Color3.fromRGB(100, 200, 100)
                    else
                        statusLabel.Text = (currentLang == "ru") and "✗ Не удалось телепортироваться к " .. player.Name or "✗ Failed to teleport to " .. player.Name
                        statusLabel.TextColor3 = Color3.fromRGB(255, 120, 120)
                    end
                    task.wait(2)
                    statusLabel.Text = ""
                end
            end)
            
            yOffset = yOffset + 40
        end
    end
    
    if playerCount == 0 then
        local emptyLabel = Instance.new("TextLabel")
        emptyLabel.Size = UDim2.new(1, -20, 0, 35)
        emptyLabel.Position = UDim2.new(0, 0, 0, 0)
        emptyLabel.Text = (currentLang == "ru") and "Нет других игроков на сервере" or "No other players on server"
        emptyLabel.TextColor3 = Color3.fromRGB(180, 180, 200)
        emptyLabel.BackgroundTransparency = 1
        emptyLabel.Font = Enum.Font.Gotham
        emptyLabel.TextSize = 12
        emptyLabel.Parent = container
        yOffset = 40
    end
    
    container.Size = UDim2.new(1, 0, 0, yOffset + 10)
end

