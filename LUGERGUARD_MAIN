-- Список оружия маньяка
local MURDERER_WEAPONS = {
    "Knife", "MurdererKnife", "Dagger", "Sword", "Axe", 
    "ButterflyKnife", "Karambit", "Machete", "Katana"
}

-- Список оружия шерифа
local SHERIFF_WEAPONS = {
    "Gun", "Revolver", "Pistol", "Flintlock", "SheriffGun",
    "Handgun", "Magnum", "Colt"
}

-- Функция определения роли игрока
local function getPlayerRole(player)
    if not player or player == LocalPlayer then
        return "Normal"
    end
    
    local character = player.Character
    if not character then
        return "Unknown"
    end
    
    local hasMurdererWeapon = false
    local hasSheriffWeapon = false
    
    -- Проверка оружия в руках (Character)
    for _, weaponName in pairs(MURDERER_WEAPONS) do
        local weapon = character:FindFirstChild(weaponName)
        if weapon and weapon:IsA("Tool") then
            hasMurdererWeapon = true
            break
        end
    end
    
    for _, weaponName in pairs(SHERIFF_WEAPONS) do
        local weapon = character:FindFirstChild(weaponName)
        if weapon and weapon:IsA("Tool") then
            hasSheriffWeapon = true
            break
        end
    end
    
    -- Проверка через Backpack
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, weaponName in pairs(MURDERER_WEAPONS) do
            local weapon = backpack:FindFirstChild(weaponName)
            if weapon and weapon:IsA("Tool") then
                hasMurdererWeapon = true
                break
            end
        end
        for _, weaponName in pairs(SHERIFF_WEAPONS) do
            local weapon = backpack:FindFirstChild(weaponName)
            if weapon and weapon:IsA("Tool") then
                hasSheriffWeapon = true
                break
            end
        end
    end
    
    -- Определение роли
    if hasSheriffWeapon then
        return "Sheriff"
    elseif hasMurdererWeapon then
        return "Murderer"
    end
    
    -- Проверка через специальные атрибуты/теги
    if character:FindFirstChild("Murderer") or character:FindFirstChild("IsMurderer") then
        return "Murderer"
    end
    
    if character:FindFirstChild("Sheriff") or character:FindFirstChild("IsSheriff") then
        return "Sheriff"
    end
    
    return "Normal"
end

-- Получение цвета для игрока
local function getPlayerColorForMM2(player)
    local role = getPlayerRole(player)
    return ROLE_COLORS[role] or ROLE_COLORS.Normal
end

