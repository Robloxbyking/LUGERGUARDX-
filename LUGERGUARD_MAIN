-- ========== АИМБОТ (НОВАЯ ФУНКЦИЯ) ==========
local function getBestTarget()
    local bestPlayer = nil
    local bestDistance = aimbotFOV
    local mousePos = Vector2.new(mouse.X, mouse.Y)
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetPart = player.Character:FindFirstChild(aimbotTargetPart)
            if targetPart then
                local screenPos, onScreen = workspace.CurrentCamera:WorldToScreenPoint(targetPart.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < bestDistance then
                        bestDistance = dist
                        bestPlayer = player
                    end
                end
            end
        end
    end
    return bestPlayer
end

local function smoothLookAt(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    local targetPart = targetPlayer.Character:FindFirstChild(aimbotTargetPart)
    if not targetPart then return end
    local camera = workspace.CurrentCamera
    local newCFrame = CFrame.new(camera.CFrame.Position, targetPart.Position)
    camera.CFrame = camera.CFrame:Lerp(newCFrame, aimbotSmoothing)
end

local function onAimbot()
    if not aimbotEnabled then return end
    if aimbotOnlyOnKey and not UserInputService:IsKeyDown(aimbotKey) then return end
    local target = getBestTarget()
    if target then smoothLookAt(target) end
end

local function startAimbot()
    if aimbotConnection then return end
    aimbotConnection = RunService.RenderStepped:Connect(onAimbot)
end

local function stopAimbot()
    if aimbotConnection then
        aimbotConnection:Disconnect()
        aimbotConnection = nil
    end
end

local function enableAimbot()
    if aimbotEnabled then return end
    aimbotEnabled = true
    startAimbot()
end

local function disableAimbot()
    if not aimbotEnabled then return end
    aimbotEnabled = false
    stopAimbot()
end

-- ========== НАСТРОЙКА ХОТКЕЕВ (НОВАЯ ФУНКЦИЯ) ==========
local function setupKeybinds()
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        local key = input.KeyCode
        
        if key == keybinds.toggleFly then
            if flying then stopFly() else startFly() end
        elseif key == keybinds.toggleNoclip then
            if noclipEnabled then stopNoclip() else startNoclip() end
        elseif key == keybinds.toggleESP then
            if espEnabled then disableESP() else enableESP() end
        elseif key == keybinds.toggleSpeed then
            speedEnabled = not speedEnabled
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum.WalkSpeed = speedEnabled and currentSpeed or 16 end
            end
        elseif key == keybinds.toggleInfiniteJump then
            if infiniteJumpEnabled then disableInfiniteJump() else enableInfiniteJump() end
        elseif key == keybinds.toggleFullBright then
            if fullBrightEnabled then disableFullBright() else enableFullBright() end
        elseif key == keybinds.toggleAimbot then
            if aimbotEnabled then disableAimbot() else enableAimbot() end
        elseif key == keybinds.toggleNameTags then
            if nameTagsEnabled then disableNameTags() else enableNameTags() end
        elseif key == keybinds.toggleAntiAfk then
            if antiAfkEnabled then stopAntiAfk() else startAntiAfk() end
        end
    end)
end

