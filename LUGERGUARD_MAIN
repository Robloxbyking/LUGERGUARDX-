    local totalHeight = 0
    for _, child in pairs(contentContainer:GetChildren()) do
        if child:IsA("TextLabel") or child:IsA("TextBox") or child:IsA("TextButton") or child:IsA("Frame") then
            totalHeight = totalHeight + child.Size.Y.Offset + 10
        end
    end
    contentContainer.Size = UDim2.new(1, 0, 0, math.max(totalHeight + 20, rightContent.Size.Y.Offset))
    rightContent.CanvasSize = UDim2.new(0, 0, 0, totalHeight + 30)
end

