        btn.BackgroundTransparency = 0.6
        btn.BorderSizePixel = 0
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 14
        btn.Parent = buttonsContainer
        
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 8)
        btnCorner.Parent = btn
        
        btn.MouseButton1Click:Connect(function()
            if activeTab == tab then return end
            for _, b in pairs(tabButtons) do
                b.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
                b.BackgroundTransparency = 0.6
                b.TextColor3 = Color3.fromRGB(160, 170, 190)
            end
            btn.BackgroundColor3 = Color3.fromRGB(0, 80, 140)
            btn.BackgroundTransparency = 0.3
            btn.TextColor3 = Color3.fromRGB(0, 200, 255)
            activeTab = tab
            updateContent()
        end)
        
        tabButtons[tab] = btn
        currentY = currentY + buttonHeight + buttonSpacing
    end
    
    buttonsContainer.Size = UDim2.new(1, 0, 0, currentY + 20)
    leftPanel.CanvasSize = UDim2.new(0, 0, 0, currentY + 30)
    
    activeTab = "Main"
    tabButtons["Main"].BackgroundColor3 = Color3.fromRGB(0, 80, 140)
    tabButtons["Main"].BackgroundTransparency = 0.3
    tabButtons["Main"].TextColor3 = Color3.fromRGB(0, 200, 255)
    
    updateContent()
    
    local isMinimized = false
    minimizeBtn.MouseButton1Click:Connect(function()
        isMinimized = not isMinimized
        if isMinimized then
            TweenService:Create(mainFrame, TweenInfo.new(0.3), {Size = UDim2.new(0, currentWidth, 0, 85)}):Play()
            TweenService:Create(contentFrame, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
            task.wait(0.15)
            contentFrame.Visible = false
        else
            contentFrame.Visible = true
            TweenService:Create(contentFrame, TweenInfo.new(0.2), {BackgroundTransparency = 0.4}):Play()
            TweenService:Create(mainFrame, TweenInfo.new(0.3), {Size = UDim2.new(0, currentWidth, 0, currentHeight)}):Play()
        end
    end)
    
    closeBtn.MouseButton1Click:Connect(function()
        TweenService:Create(mainFrame, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
        task.wait(0.2)
        screenGui:Destroy()
    end)
    
    local dragging = false
    local dragStart = nil
    local startPos = nil
    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = Vector2.new(input.Position.X, input.Position.Y)
            startPos = mainFrame.Position
        end
    end)
    topBar.InputEnded:Connect(function()
        dragging = false
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    local function resizeWindow(newWidth, newHeight)
        newWidth = math.clamp(newWidth, minWidth, maxWidth)
        newHeight = math.clamp(newHeight, minHeight, maxHeight)
        currentWidth = newWidth
        currentHeight = newHeight
        local newXOffset = -newWidth/2
        local newYOffset = -newHeight/2
        TweenService:Create(mainFrame, TweenInfo.new(0.2), {
            Size = UDim2.new(0, newWidth, 0, newHeight),
            Position = UDim2.new(0.5, newXOffset, 0.5, newYOffset)
        }):Play()
        if not isMinimized then
            contentFrame.Visible = true
            contentFrame.BackgroundTransparency = 0.4
        end
        updateContentHeight()
    end
    
    local sizes = {{500, 400}, {650, 450}, {750, 520}, {900, 600}, {1000, 700}}
    local sizeIndex = 3
    
    resizeBtn.MouseButton1Click:Connect(function()
        if isMinimized then
            isMinimized = false
            contentFrame.Visible = true
            contentFrame.BackgroundTransparency = 0.4
            TweenService:Create(mainFrame, TweenInfo.new(0.3), {Size = UDim2.new(0, currentWidth, 0, currentHeight)}):Play()
        else
            sizeIndex = sizeIndex % #sizes + 1
            local newSize = sizes[sizeIndex]
            resizeWindow(newSize[1], newSize[2])
        end
    end)
    
    local avatarFrame = Instance.new("Frame")
    avatarFrame.Size = UDim2.new(0, 45, 0, 45)
    avatarFrame.Position = UDim2.new(0, 10, 1, -55)
    avatarFrame.BackgroundColor3 = Color3.fromRGB(0, 100, 180)
    avatarFrame.BackgroundTransparency = 0.4
    avatarFrame.BorderSizePixel = 0
    avatarFrame.Parent = contentFrame
    
    local avatarCorner = Instance.new("UICorner")
    avatarCorner.CornerRadius = UDim.new(1, 0)
    avatarCorner.Parent = avatarFrame
    
    local avatarImage = Instance.new("ImageLabel")
    avatarImage.Size = UDim2.new(1, -4, 1, -4)
    avatarImage.Position = UDim2.new(0, 2, 0, 2)
    avatarImage.BackgroundTransparency = 1
    avatarImage.Parent = avatarFrame
    
    local avatarImageCorner = Instance.new("UICorner")
    avatarImageCorner.CornerRadius = UDim.new(1, 0)
    avatarImageCorner.Parent = avatarImage
    avatarImage.Image = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. LocalPlayer.UserId .. "&width=100&height=100&format=png"
    
    local playerName = Instance.new("TextLabel")
    playerName.Size = UDim2.new(0, 100, 0, 20)
    playerName.Position = UDim2.new(0, 60, 1, -50)
    playerName.Text = "@" .. LocalPlayer.Name
    playerName.TextColor3 = Color3.fromRGB(100, 180, 230)
    playerName.BackgroundTransparency = 1
    playerName.Font = Enum.Font.GothamBold
    playerName.TextSize = 11
    playerName.TextXAlignment = Enum.TextXAlignment.Left
    playerName.Parent = contentFrame
    
    local line = Instance.new("Frame")
    line.Size = UDim2.new(0, 100, 0, 1)
    line.Position = UDim2.new(0, 60, 1, -32)
    line.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    line.BackgroundTransparency = 0.5
    line.BorderSizePixel = 0
    line.Parent = contentFrame
end

