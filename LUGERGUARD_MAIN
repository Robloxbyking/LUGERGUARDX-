local function createColorButton(parent,x,y,colorName,colorValue)
 local btn=Instance.new("TextButton")
 btn.Size=UDim2.new(0,80,0,35)
 btn.Position=UDim2.new(0,x,0,y)
 btn.Text=colorName
 btn.TextColor3=Color3.fromRGB(255,255,255)
 btn.BackgroundColor3=colorValue.main
 btn.BackgroundTransparency=0.3
 btn.BorderSizePixel=0
 btn.Font=Enum.Font.GothamBold
 btn.TextSize=12
 btn.Parent=parent
 Instance.new("UICorner").CornerRadius=UDim.new(0,6).Parent=btn
 btn.MouseButton1Click:Connect(function()
  applyTheme(colorName)
  -- Обновляем активную кнопку визуально
  for _,ch in pairs(parent:GetChildren()) do
   if ch:IsA("TextButton") then
    ch.BackgroundTransparency=0.3
   end
  end
  btn.BackgroundTransparency=0.1
 end)
 if currentTheme==colorName then btn.BackgroundTransparency=0.1 end
 return btn
end

local function updTeleList(cont,status)
 for _,ch in pairs(cont:GetChildren()) do ch:Destroy() end
 local yOff=0
 local pc=0
 for _,p in pairs(Players:GetPlayers()) do
  if p~=LocalPlayer then
   pc=pc+1
   local fr=Instance.new("Frame")
   fr.Size=UDim2.new(1,-20,0,35)
   fr.Position=UDim2.new(0,0,0,yOff)
   fr.BackgroundColor3=Color3.fromRGB(25,30,35)
   fr.BackgroundTransparency=0.4
   fr.BorderSizePixel=0
   fr.Parent=cont
   Instance.new("UICorner").CornerRadius=UDim.new(0,6).Parent=fr
   local nl=Instance.new("TextLabel")
   nl.Size=UDim2.new(1,-70,1,0)
   nl.Position=UDim2.new(0,12,0,0)
   nl.Text=p.Name
   nl.TextColor3=Color3.fromRGB(210,215,225)
   nl.BackgroundTransparency=1
   nl.Font=Enum.Font.Gotham
   nl.TextSize=13
   nl.TextXAlignment=Enum.TextXAlignment.Left
   nl.Parent=fr
   local btn=Instance.new("TextButton")
   btn.Size=UDim2.new(0,55,0,26)
   btn.Position=UDim2.new(1,-62,0,4.5)
   btn.Text="TP"
   btn.TextColor3=Color3.fromRGB(255,255,255)
   btn.BackgroundColor3=Color3.fromRGB(0,100,180)
   btn.BackgroundTransparency=0.2
   btn.BorderSizePixel=0
   btn.Font=Enum.Font.GothamBold
   btn.TextSize=12
   btn.Parent=fr
   Instance.new("UICorner").CornerRadius=UDim.new(0,4).Parent=btn
   btn.MouseEnter:Connect(function() btn.BackgroundTransparency=0.4 btn.TextColor3=Color3.fromRGB(0,200,255) end)
   btn.MouseLeave:Connect(function() btn.BackgroundTransparency=0.2 btn.TextColor3=Color3.fromRGB(255,255,255) end)
   btn.MouseButton1Click:Connect(function()
    local suc=tpToPlayer(p)
    if status then
     if suc then status.Text=(currentLang=="ru") and "✓ Телепортирован к "..p.Name or "✓ Teleported to "..p.Name
     else status.Text=(currentLang=="ru") and "✗ Не удалось телепортироваться к "..p.Name or "✗ Failed to teleport to "..p.Name end
     status.TextColor3=suc and Color3.fromRGB(100,200,100) or Color3.fromRGB(255,120,120)
     task.wait(2)
     status.Text=""
    end
   end)
   yOff=yOff+40
  end
 end
 if pc==0 then
  local el=Instance.new("TextLabel")
  el.Size=UDim2.new(1,-20,0,35)
  el.Position=UDim2.new(0,0,0,0)
  el.Text=(currentLang=="ru") and "Нет других игроков на сервере" or "No other players on server"
  el.TextColor3=Color3.fromRGB(180,180,200)
  el.BackgroundTransparency=1
  el.Font=Enum.Font.Gotham
  el.TextSize=12
  el.Parent=cont
  yOff=40
 end
 cont.Size=UDim2.new(1,0,0,yOff+10)
end

local function updHeight()
 local th=0
 for _,ch in pairs(contentContainer:GetChildren()) do
  if ch:IsA("TextLabel") or ch:IsA("TextBox") or ch:IsA("TextButton") or ch:IsA("Frame") then th=th+ch.Size.Y.Offset+10 end
 end
 contentContainer.Size=UDim2.new(1,0,0,math.max(th+20,rightContent.Size.Y.Offset))
 rightContent.CanvasSize=UDim2.new(0,0,0,th+30)
end

