-- Настройки ESP
local ESP_CONFIG = {
    FillTransparency = 0.7,
    OutlineTransparency = 0.5,
    OutlineColor = Color3.fromRGB(255, 255, 255),
    DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
}

-- Цвета для разных ролей в MM2
local ROLE_COLORS = {
    Murderer = Color3.fromRGB(255, 50, 50),
    Sheriff = Color3.fromRGB(50, 150, 255),
    Normal = Color3.fromRGB(150, 150, 150),
    Unknown = Color3.fromRGB(200, 200, 100)
}

-- Список оружия маньяка
local MURDERER_WEAPONS = {
    "Knife", "MurdererKnife", "Dagger", "Sword", "Axe", 
    "ButterflyKnife", "Karambit", "Machete", "Katana"
}

-- Список оружия шерифа
local SHERIFF_WEAPONS = {
    "Gun", "Revolver", "Pistol", "Flintlock", "SheriffGun",
    "Handgun", "Magnum", "Colt"
}

-- Функция определения роли игрока
local function getPlayerRole(player)
    if not player or player == LocalPlayer then
        return "Normal"
    end
    
    local character = player.Character
    if not character then
        return "Unknown"
    end
    
    local hasMurdererWeapon = false
    local hasSheriffWeapon = false
    
    for _, weaponName in pairs(MURDERER_WEAPONS) do
        local weapon = character:FindFirstChild(weaponName)
        if weapon and weapon:IsA("Tool") then
            hasMurdererWeapon = true
            break
        end
    end
    
    for _, weaponName in pairs(SHERIFF_WEAPONS) do
        local weapon = character:FindFirstChild(weaponName)
        if weapon and weapon:IsA("Tool") then
            hasSheriffWeapon = true
            break
        end
    end
    
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, weaponName in pairs(MURDERER_WEAPONS) do
            local weapon = backpack:FindFirstChild(weaponName)
            if weapon and weapon:IsA("Tool") then
                hasMurdererWeapon = true
                break
            end
        end
        for _, weaponName in pairs(SHERIFF_WEAPONS) do
            local weapon = backpack:FindFirstChild(weaponName)
            if weapon and weapon:IsA("Tool") then
                hasSheriffWeapon = true
                break
            end
        end
    end
    
    if hasSheriffWeapon then
        return "Sheriff"
    elseif hasMurdererWeapon then
        return "Murderer"
    end
    
    if character:FindFirstChild("Murderer") or character:FindFirstChild("IsMurderer") then
        return "Murderer"
    end
    
    if character:FindFirstChild("Sheriff") or character:FindFirstChild("IsSheriff") then
        return "Sheriff"
    end
    
    return "Normal"
end

local function getPlayerColorForMM2(player)
    local role = getPlayerRole(player)
    return ROLE_COLORS[role] or ROLE_COLORS.Normal
end

-- Обработчик добавления оружия
local function setupWeaponDetection(player)
    if not player or player == LocalPlayer then return end
    if espWeaponConnections[player] then return end
    
    local function onWeaponAdded(weapon)
        if weapon:IsA("Tool") then
            updateESPColorForPlayer(player)
            if nameTagsEnabled then
                updateNameTagColorForPlayer(player)
            end
        end
    end
    
    local function onCharacterAdded(character)
        task.wait(0.5)
        character.ChildAdded:Connect(onWeaponAdded)
        addESPToPlayer(player)
    end
    
    if player.Character then
        player.Character.ChildAdded:Connect(onWeaponAdded)
    else
        player.CharacterAdded:Connect(onCharacterAdded)
    end
    
    espWeaponConnections[player] = true
end

-- Создание ESP для одного игрока
local function addESPToPlayer(player)
    if not player or player == LocalPlayer then return end
    if not espEnabled then return end
    if not player.Character then return end
    
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    if espHighlightObjects[player] then
        pcall(function() espHighlightObjects[player]:Destroy() end)
        espHighlightObjects[player] = nil
    end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "LugerGuardESP"
    highlight.Adornee = character
    highlight.FillColor = getPlayerColorForMM2(player)
    highlight.FillTransparency = ESP_CONFIG.FillTransparency
    highlight.OutlineColor = ESP_CONFIG.OutlineColor
    highlight.OutlineTransparency = ESP_CONFIG.OutlineTransparency
    highlight.DepthMode = ESP_CONFIG.DepthMode
    highlight.Parent = character
    
    espHighlightObjects[player] = highlight
    setupWeaponDetection(player)
end

local function removeESPFromPlayer(player)
    if espHighlightObjects[player] then
        pcall(function() espHighlightObjects[player]:Destroy() end)
        espHighlightObjects[player] = nil
    end
end

local function updateESPColorForPlayer(player)
    if not espEnabled then return end
    if not espHighlightObjects[player] then return end
    
    pcall(function()
        espHighlightObjects[player].FillColor = getPlayerColorForMM2(player)
    end)
end

-- Основной цикл обновления цветов ESP
local function startESPColorUpdateLoop()
    if espColorUpdateLoop then return end
    
    espColorUpdateLoop = task.spawn(function()
        while espEnabled do
            for player, _ in pairs(espHighlightObjects) do
                if player and player.Character then
                    updateESPColorForPlayer(player)
                end
            end
            task.wait(0.3)
        end
        espColorUpdateLoop = nil
    end)
end

-- Включение ESP
local function enableESP()
    if espEnabled then return end
    espEnabled = true
    
    -- Добавляем ESP для всех текущих игроков
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            addESPToPlayer(player)
        end
    end
    
    startESPColorUpdateLoop()
    
    -- Следим за новыми игроками
    espPlayerAddedConnection = Players.PlayerAdded:Connect(function(player)
        if espEnabled and player ~= LocalPlayer then
            local function onCharacterReady()
                task.wait(0.5)
                addESPToPlayer(player)
            end
            
            if player.Character then
                addESPToPlayer(player)
            else
                player.CharacterAdded:Once(onCharacterReady)
            end
        end
    end)
    
    -- Следим за появлением персонажа у существующих игроков
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not espHighlightObjects[player] then
            local function onCharacterAdded()
                task.wait(0.5)
                addESPToPlayer(player)
            end
            
            if player.Character then
                addESPToPlayer(player)
            else
                player.CharacterAdded:Once(onCharacterAdded)
            end
        end
    end
end

-- Выключение ESP
local function disableESP()
    if not espEnabled then return end
    espEnabled = false
    
    if espPlayerAddedConnection then
        espPlayerAddedConnection:Disconnect()
        espPlayerAddedConnection = nil
    end
    
    for player, highlight in pairs(espHighlightObjects) do
        pcall(function() highlight:Destroy() end)
    end
    espHighlightObjects = {}
    
    for player, _ in pairs(espWeaponConnections) do
        espWeaponConnections[player] = nil
    end
end

