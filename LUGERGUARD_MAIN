 espColorUpdateLoop=task.spawn(function()
  while espEnabled do
   for p,_ in pairs(espHighlightObjects) do
    if p and p.Character then updESPColor(p) end
   end
   task.wait(0.3)
  end
  espColorUpdateLoop=nil
 end)
end
local function enESP()
