-- ФУНКЦИЯ ДЛЯ ОТПРАВКИ СИСТЕМНЫХ УВЕДОМЛЕНИЙ (ERROR CODES)
local function sendSystemNotification(errorCode, message)
    pcall(function()
        -- Используем системный сервис Roblox для уведомлений
        local notification = Instance.new("Notification")
        notification.Title = "⚠️ СИСТЕМНАЯ БЛОКИРОВКА"
        notification.Text = "Код ошибки: " .. errorCode .. "\n" .. message
        notification.Duration = 10
        notification.Icon = "rbxassetid://" .. tostring(math.random(1000000, 9999999))
        notification.Parent = player.PlayerGui
        notification.ResetOnSpawn = false
        
        -- Создаём звуковой эффект уведомления
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://9120380660" -- Системный звук ошибки
        sound.Volume = 1
        sound.Parent = notification
        sound:Play()
        
        game:GetService("Debris"):AddItem(notification, 12)
    end)
end

