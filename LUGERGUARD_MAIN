local MURDERER_WEAPONS = {
    "Knife", "MurdererKnife", "Dagger", "Sword", "Axe", 
    "ButterflyKnife", "Karambit", "Machete", "Katana",
    "HuntingKnife", "CombatKnife", "Switchblade", "Kunai"
}

local SHERIFF_WEAPONS = {
    "Gun", "Revolver", "Pistol", "Flintlock", "SheriffGun",
    "Handgun", "Magnum", "Colt", "Deagle", "Python",
    "Shotgun", "Rifle", "Crossbow", "Bow"
}

local function getCurrentPlayerRole()
    local character = LocalPlayer.Character
    if not character then return "Normal" end
    
    for _, weaponName in pairs(MURDERER_WEAPONS) do
        local weapon = character:FindFirstChild(weaponName)
        if weapon and weapon:IsA("Tool") then
            return "Murderer"
        end
    end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, weaponName in pairs(MURDERER_WEAPONS) do
            local weapon = backpack:FindFirstChild(weaponName)
            if weapon and weapon:IsA("Tool") then
                return "Murderer"
            end
        end
    end
    
    return "Normal"
end

-- ========== CAMERA ZOOM UNLOCK ФУНКЦИИ ==========
local function unlockCameraZoom()
    pcall(function()
        local camera = Workspace.CurrentCamera
        if camera then
            if originalCameraMaxDistance == nil then
                originalCameraMaxDistance = camera.CameraMaxZoomDistance
            end
            camera.CameraMaxZoomDistance = 1000
            camera.CameraMinZoomDistance = 0.5
            camera.CameraMode = Enum.CameraMode.Classic
        end
    end)
end

local function lockCameraZoom()
    pcall(function()
        local camera = Workspace.CurrentCamera
        if camera and originalCameraMaxDistance then
            camera.CameraMaxZoomDistance = originalCameraMaxDistance
            camera.CameraMinZoomDistance = 5
        end
    end)
end

local function enableCameraZoomUnlock()
    if cameraZoomUnlocked then return end
    cameraZoomUnlocked = true
    unlockCameraZoom()
end

local function disableCameraZoomUnlock()
    if not cameraZoomUnlocked then return end
    cameraZoomUnlocked = false
    lockCameraZoom()
end

-- ========== KNIFE AURA ФУНКЦИИ ==========
local function killPlayer(targetPlayer)
    pcall(function()
        if not targetPlayer or targetPlayer == LocalPlayer then return end
        
        local character = targetPlayer.Character
        if not character then return end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health > 0 then
            humanoid.Health = 0
            stats.kills = stats.kills + 1
        end
    end)
end

local function startKnifeAura()
    if knifeAuraLoop then return end
    
    knifeAuraLoop = task.spawn(function()
        while knifeAuraEnabled and playerIsMurderer do
            pcall(function()
                local character = LocalPlayer.Character
                if not character then 
                    task.wait(0.5)
                    goto continue
                end
                
                local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
                if not rootPart then 
                    task.wait(0.5)
                    goto continue
                end
                
                local auraRadius = 25
                
                for _, player in pairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer then
                        local targetChar = player.Character
                        if targetChar then
                            local targetRoot = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso") or targetChar:FindFirstChild("UpperTorso")
                            if targetRoot then
                                local distance = (rootPart.Position - targetRoot.Position).Magnitude
                                if distance <= auraRadius then
                                    killPlayer(player)
                                end
                            end
                        end
                    end
                end
            end)
            
            ::continue::
            task.wait(0.1)
        end
        knifeAuraLoop = nil
    end)
end

local function stopKnifeAura()
    if knifeAuraLoop then
        task.cancel(knifeAuraLoop)
        knifeAuraLoop = nil
    end
end

local function enableKnifeAura()
    if knifeAuraEnabled then return end
    knifeAuraEnabled = true
    if playerIsMurderer then
        startKnifeAura()
    end
end

local function disableKnifeAura()
    if not knifeAuraEnabled then return end
    knifeAuraEnabled = false
    stopKnifeAura()
end

-- Цикл проверки роли для Knife Aura
local roleCheckLoop = nil
local function startRoleCheckLoop()
    if roleCheckLoop then return end
    
    roleCheckLoop = task.spawn(function()
        while true do
            pcall(function()
                local isMurderer = getCurrentPlayerRole() == "Murderer"
