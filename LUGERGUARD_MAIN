local function startFly()
    if flying then return end
    flying = true
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    if not hum or not torso then return end
    hum.PlatformStand = true
    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.P = 9e4
    flyBodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBodyGyro.cframe = torso.CFrame
    flyBodyGyro.Parent = torso
    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.velocity = Vector3.new(0, 0.1, 0)
    flyBodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBodyVelocity.Parent = torso
    
    local function updateFly()
        while flying and char and char.Parent do
            task.wait()
            if not flying then break end
            local moveDir = Vector3.new(flyCtrl.r - flyCtrl.l, 0, flyCtrl.f - flyCtrl.b)
            if moveDir.Magnitude > 0 then
                flySpeedValue = flySpeedValue + 0.5 + (flySpeedValue / flyMaxSpeed)
                if flySpeedValue > flyMaxSpeed then flySpeedValue = flyMaxSpeed end
            elseif flySpeedValue ~= 0 then
                flySpeedValue = flySpeedValue - 1
                if flySpeedValue < 0 then flySpeedValue = 0 end
            end
            local cam = workspace.CurrentCamera
            if cam then
                local cf = cam.CoordinateFrame
                if moveDir.Magnitude > 0 then
                    local vel = (cf.LookVector * (flyCtrl.f - flyCtrl.b)) + (cf.RightVector * (flyCtrl.r - flyCtrl.l))
                    flyBodyVelocity.velocity = vel * flySpeedValue
                    flyLastCtrl = {f = flyCtrl.f, b = flyCtrl.b, l = flyCtrl.l, r = flyCtrl.r}
                elseif flySpeedValue ~= 0 then
                    local vel = (cf.LookVector * (flyLastCtrl.f - flyLastCtrl.b)) + (cf.RightVector * (flyLastCtrl.r - flyLastCtrl.l))
                    flyBodyVelocity.velocity = vel * flySpeedValue
                else
                    flyBodyVelocity.velocity = Vector3.new(0, 0, 0)
                end
                if flyBodyGyro then
                    flyBodyGyro.cframe = cam.CoordinateFrame * CFrame.Angles(-math.rad((flyCtrl.f + flyCtrl.b) * 50 * flySpeedValue / flyMaxSpeed), 0, 0)
                end
            end
        end
    end
    
    if not flyInputsConnected then
        flyInputsConnected = true
        UserInputService.InputBegan:Connect(function(inp, gp)
            if gp or not flying then return end
            local k = inp.KeyCode
            if k == Enum.KeyCode.W then flyCtrl.f = 1
            elseif k == Enum.KeyCode.S then flyCtrl.b = 1
            elseif k == Enum.KeyCode.A then flyCtrl.l = 1
            elseif k == Enum.KeyCode.D then flyCtrl.r = 1 end
        end)
        UserInputService.InputEnded:Connect(function(inp)
            if not flying then return end
            local k = inp.KeyCode
            if k == Enum.KeyCode.W then flyCtrl.f = 0
            elseif k == Enum.KeyCode.S then flyCtrl.b = 0
            elseif k == Enum.KeyCode.A then flyCtrl.l = 0
            elseif k == Enum.KeyCode.D then flyCtrl.r = 0 end
        end)
    end
    
    coroutine.wrap(updateFly)()
    if currentFlySwitchState then currentFlySwitchState(true) end
end

local function stopFly()
    if not flying then return end
    flying = false
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
    if flyBodyVelocity then flyBodyVelocity:Destroy() flyBodyVelocity = nil end
    if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
    flyCtrl = {f = 0, b = 0, l = 0, r = 0}
    flyLastCtrl = {f = 0, b = 0, l = 0, r = 0}
    flySpeedValue = flySpeed
    if currentFlySwitchState then currentFlySwitchState(false) end
end

flyKeybindConnection = UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    if inp.KeyCode == Enum.KeyCode.Q then
        if flying then stopFly() else startFly() end
    end
