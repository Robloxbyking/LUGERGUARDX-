-- Функция постоянного обновления цветов ESP
local function startColorUpdateLoop()
    if espColorUpdateLoop then return end
    
    espColorUpdateLoop = task.spawn(function()
        while espEnabled do
            for player, _ in pairs(espHighlightObjects) do
                if player and player.Character then
                    updateESPColorForPlayer(player)
                end
            end
            task.wait(0.3)
        end
        espColorUpdateLoop = nil
    end)
end

-- Включение ESP для всех игроков
local function enableESP()
    if espEnabled then return end
    espEnabled = true
    
    -- Добавляем ESP для всех текущих игроков
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            addESPToPlayer(player)
        end
    end
    
    -- Запускаем цикл обновления цветов
    startColorUpdateLoop()
    
    -- Следим за появлением новых игроков и добавляем им ESP
    local function onPlayerAdded(player)
        if espEnabled and player ~= LocalPlayer then
            local function onCharacterAdded()
                task.wait(0.5)
                addESPToPlayer(player)
            end
            if player.Character then
                addESPToPlayer(player)
            else
                player.CharacterAdded:Once(onCharacterAdded)
            end
        end
    end
    
    espLoopConnection = Players.PlayerAdded:Connect(onPlayerAdded)
    
    -- Обрабатываем уже существующих игроков, у которых ещё нет ESP
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not espHighlightObjects[player] and player.Character then
            addESPToPlayer(player)
        end
    end
    
    -- Следим за добавлением оружия (мгновенное обновление)
    local function onWeaponAdded(child)
        if child:IsA("Tool") then
            for player, _ in pairs(espHighlightObjects) do
                if player.Character and child.Parent == player.Character then
                    updateESPColorForPlayer(player)
                    if nameTagsEnabled then
                        updateNameTagColorForPlayer(player)
                    end
                end
            end
        end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            player.Character.ChildAdded:Connect(onWeaponAdded)
        end
    end
end

-- Выключение ESP
local function disableESP()
    if not espEnabled then return end
    espEnabled = false
    
    if espLoopConnection then
        espLoopConnection:Disconnect()
        espLoopConnection = nil
    end
    
    for player, highlight in pairs(espHighlightObjects) do
        pcall(function()
            highlight:Destroy()
        end)
    end
    espHighlightObjects = {}
end

-- Обновление ESP после перезагрузки персонажа
local function refreshESP()
    if not espEnabled then return end
    
    for player, highlight in pairs(espHighlightObjects) do
        if player and player.Character then
            pcall(function()
                highlight.Adornee = player.Character
                highlight.FillColor = getPlayerColorForMM2(player)
            end)
        else
            removeESPFromPlayer(player)
        end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not espHighlightObjects[player] then
            addESPToPlayer(player)
        end
    end
end

