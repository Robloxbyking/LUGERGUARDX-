        Main = getText("Главная", "Main"),
        Players = getText("Игроки", "Players"),
        Visual = getText("Визуал", "Visual"),
        Teleport = getText("Телепорт", "Teleport"),
        ESP = "ESP",
        Feedback = getText("Отзывы", "Feedback"),
        Settings = getText("Настройки", "Settings")
    }
    
    for _, tab in pairs(tabs) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -10, 0, 40)
        btn.Position = UDim2.new(0, 5, 0, yOff)
        btn.Text = tabNames[tab]
        btn.TextColor3 = Color3.fromRGB(160, 170, 190)
        btn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
        btn.BackgroundTransparency = 0.6
        btn.BorderSizePixel = 0
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 14
        btn.Parent = btnContainer
        Instance.new("UICorner").CornerRadius = UDim.new(0, 8).Parent = btn
        
        btn.MouseButton1Click:Connect(function()
            for _, b in pairs(tabButtons) do
                b.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
                b.BackgroundTransparency = 0.6
                b.TextColor3 = Color3.fromRGB(160, 170, 190)
            end
            btn.BackgroundColor3 = Color3.fromRGB(0, 80, 140)
            btn.BackgroundTransparency = 0.3
            btn.TextColor3 = Color3.fromRGB(0, 200, 255)
            activeTab = tab
            updateContent()
        end)
        
        tabButtons[tab] = btn
        yOff = yOff + 45
    end
    
    btnContainer.Size = UDim2.new(1, 0, 0, yOff + 10)
    leftPanel.CanvasSize = UDim2.new(0, 0, 0, yOff + 20)
    
    -- Активация главной вкладки
    if tabButtons["Main"] then
        tabButtons["Main"].BackgroundColor3 = Color3.fromRGB(0, 80, 140)
        tabButtons["Main"].BackgroundTransparency = 0.3
        tabButtons["Main"].TextColor3 = Color3.fromRGB(0, 200, 255)
    end
    
    updateContent()
    applyTheme()
    
    -- Минимизация
    local isMinimized = false
    minimizeBtn.MouseButton1Click:Connect(function()
        isMinimized = not isMinimized
        if isMinimized then
            TweenService:Create(mainFrame, TweenInfo.new(0.3), {Size = UDim2.new(0, currentWidth, 0, 85)}):Play()
            contentFrame.Visible = false
        else
            contentFrame.Visible = true
            TweenService:Create(mainFrame, TweenInfo.new(0.3), {Size = UDim2.new(0, currentWidth, 0, currentHeight)}):Play()
        end
    end)
    
    -- Закрытие
    closeBtn.MouseButton1Click:Connect(function()
        screenGui:Destroy()
    end)
    
    -- Перетаскивание
    local dragStart, startPos, dragging = nil, nil, false
    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = Vector2.new(input.Position.X, input.Position.Y)
            startPos = mainFrame.Position
        end
    end)
    topBar.InputEnded:Connect(function() dragging = false end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-- ========== ЗАПУСК ==========
pcall(function()
    createUI()
    print("✅ LugerGuard X полностью загружен! Все 7 вкладок работают")
end)
