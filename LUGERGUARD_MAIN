local function createSwitch(par,x,y,txt,isOn,cb)
 local c=Instance.new("Frame")
 c.Size=UDim2.new(0,200,0,30)
 c.Position=UDim2.new(0,x,0,y)
 c.BackgroundTransparency=1
 c.Parent=par
 local l=Instance.new("TextLabel")
 l.Size=UDim2.new(0,120,1,0)
 l.Position=UDim2.new(0,0,0,0)
 l.Text=txt
 l.TextColor3=Color3.fromRGB(200,210,230)
 l.BackgroundTransparency=1
 l.Font=Enum.Font.Gotham
 l.TextSize=14
 l.TextXAlignment=Enum.TextXAlignment.Left
 l.Parent=c
 local bg=Instance.new("Frame")
 bg.Size=UDim2.new(0,40,0,20)
 bg.Position=UDim2.new(1,-45,0,5)
 bg.BackgroundColor3=isOn and Color3.fromRGB(0,150,255) or Color3.fromRGB(80,80,90)
 bg.BackgroundTransparency=0.3
 bg.BorderSizePixel=0
 bg.Parent=c
 Instance.new("UICorner").CornerRadius=UDim.new(1,0).Parent=bg
 local knob=Instance.new("Frame")
 knob.Size=UDim2.new(0,16,0,16)
 knob.Position=isOn and UDim2.new(1,-18,0,2) or UDim2.new(0,2,0,2)
 knob.BackgroundColor3=Color3.fromRGB(255,255,255)
 knob.BackgroundTransparency=0
 knob.BorderSizePixel=0
 knob.Parent=bg
 Instance.new("UICorner").CornerRadius=UDim.new(1,0).Parent=knob
 local function setState(on)
  isOn=on
  bg.BackgroundColor3=isOn and Color3.fromRGB(0,150,255) or Color3.fromRGB(80,80,90)
  knob.Position=isOn and UDim2.new(1,-18,0,2) or UDim2.new(0,2,0,2)
 end
 local btn=Instance.new("TextButton")
 btn.Size=UDim2.new(1,0,1,0)
 btn.BackgroundTransparency=1
 btn.Text=""
 btn.Parent=c
 btn.MouseButton1Click:Connect(function() setState(not isOn) cb(isOn) end)
 return c,setState
end
