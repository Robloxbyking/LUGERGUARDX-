    for _, child in pairs(contentContainer:GetChildren()) do
        if child:IsA("TextLabel") or child:IsA("TextBox") or child:IsA("TextButton") or child:IsA("Frame") then
            totalHeight = totalHeight + child.Size.Y.Offset + 10
        end
    end
    contentContainer.Size = UDim2.new(1, 0, 0, math.max(totalHeight + 20, rightContent.Size.Y.Offset))
    rightContent.CanvasSize = UDim2.new(0, 0, 0, totalHeight + 30)
end

local function updateContent()
    for _, child in pairs(contentContainer:GetChildren()) do
        child:Destroy()
    end
    
    if activeTab == "Main" then
        -- Speed
        local speedContainer, setSpeedState = createSwitch(contentContainer, 20, 20, currentLang == "ru" and "Скорость" or "Speed", speedEnabled, function(state)
            speedEnabled = state
            if speedEnabled then
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("Humanoid") then
                    character.Humanoid.WalkSpeed = currentSpeed
                end
            else
