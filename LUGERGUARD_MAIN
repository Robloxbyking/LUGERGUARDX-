local function sendFeedback(playerName, message, lang)
    if not message or message == "" then
        return
    end
    
    local data = {
        content = nil,
        embeds = {{
            title = "📝 Новый отзыв от " .. playerName,
            description = "```" .. message .. "```",
            color = 0x00aaff,
            fields = {
                {
                    name = (lang == "ru") and "📌 Язык" or "📌 Language",
                    value = (lang == "ru") and "🇷🇺 Русский" or "🇺🇸 English",
                    inline = true
                },
                {
                    name = "🕐 Время",
                    value = os.date("%Y-%m-%d %H:%M:%S"),
                    inline = true
                },
                {
                    name = "📊 Статистика",
                    value = string.format("Убийств: %d | Телепортов: %d", stats.kills, stats.teleports),
                    inline = false
                }
            },
            footer = {text = "LugerGuard X | Feedback System v2.0"}
        }}
    }
    
    local jsonData = HttpService:JSONEncode(data)
    local headers = {["Content-Type"] = "application/json"}
    
    pcall(function()
        request({
            Url = feedbackWebhook,
            Method = "POST",
            Headers = headers,
            Body = jsonData
        })
    end)
end

