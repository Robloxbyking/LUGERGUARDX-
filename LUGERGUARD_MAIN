local ESP_CONFIG={FillTransparency=0.7,OutlineTransparency=0.5,OutlineColor=Color3.fromRGB(255,255,255),DepthMode=Enum.HighlightDepthMode.AlwaysOnTop}
local ROLE_COLORS={Murderer=Color3.fromRGB(255,50,50),Sheriff=Color3.fromRGB(50,150,255),Normal=Color3.fromRGB(150,150,150),Unknown=Color3.fromRGB(200,200,100)}
local MURDERER_WEAPONS={"Knife","MurdererKnife","Dagger","Sword","Axe","ButterflyKnife","Karambit","Machete","Katana"}
local SHERIFF_WEAPONS={"Gun","Revolver","Pistol","Flintlock","SheriffGun","Handgun","Magnum","Colt"}

local function getRole(p)
 if not p or p==LocalPlayer then return "Normal" end
 local char=p.Character
 if not char then return "Unknown" end
 local hasMurderer=false
 local hasSheriff=false
 for _,w in pairs(MURDERER_WEAPONS) do
  local weapon=char:FindFirstChild(w)
  if weapon and weapon:IsA("Tool") then hasMurderer=true break end
 end
 for _,w in pairs(SHERIFF_WEAPONS) do
  local weapon=char:FindFirstChild(w)
  if weapon and weapon:IsA("Tool") then hasSheriff=true break end
 end
 local bp=p:FindFirstChild("Backpack")
 if bp then
  for _,w in pairs(MURDERER_WEAPONS) do
   local weapon=bp:FindFirstChild(w)
   if weapon and weapon:IsA("Tool") then hasMurderer=true break end
  end
  for _,w in pairs(SHERIFF_WEAPONS) do
   local weapon=bp:FindFirstChild(w)
   if weapon and weapon:IsA("Tool") then hasSheriff=true break end
  end
 end
 if hasSheriff then return "Sheriff"
 elseif hasMurderer then return "Murderer"
 end
 if char:FindFirstChild("Murderer") or char:FindFirstChild("IsMurderer") then return "Murderer" end
 if char:FindFirstChild("Sheriff") or char:FindFirstChild("IsSheriff") then return "Sheriff" end
 return "Normal"
end
local function getColor(p) return ROLE_COLORS[getRole(p)] or ROLE_COLORS.Normal end

local function addESP(p)
 if not p or p==LocalPlayer or not espEnabled then return end
 if not p.Character then return end
 local char=p.Character
 if not char or not char:FindFirstChild("HumanoidRootPart") then return end
 if espHighlightObjects[p] then pcall(function() espHighlightObjects[p]:Destroy() end) end
 local h=Instance.new("Highlight")
 h.Name="LugerGuardESP"
 h.Adornee=char
 h.FillColor=getColor(p)
 h.FillTransparency=ESP_CONFIG.FillTransparency
 h.OutlineColor=ESP_CONFIG.OutlineColor
 h.OutlineTransparency=ESP_CONFIG.OutlineTransparency
 h.DepthMode=ESP_CONFIG.DepthMode
 h.Parent=char
 espHighlightObjects[p]=h
 if not espWeaponConnections[p] then
  espWeaponConnections[p]=true
  local function onWeaponAdded(w)
   if w:IsA("Tool") then
    if espHighlightObjects[p] then pcall(function() espHighlightObjects[p].FillColor=getColor(p) end) end
    if nameTagsEnabled then
     local tag=nameTagObjects[p]
     if tag then
      local lbl=tag:FindFirstChild("NameLabel")
      if lbl then lbl.TextColor3=getColor(p) end
     end
    end
   end
  end
  if p.Character then p.Character.ChildAdded:Connect(onWeaponAdded)
  else p.CharacterAdded:Connect(function(c) task.wait(0.5) c.ChildAdded:Connect(onWeaponAdded) addESP(p) end) end
 end
end
local function remESP(p)
 if espHighlightObjects[p] then pcall(function() espHighlightObjects[p]:Destroy() end) espHighlightObjects[p]=nil end
end
local function updESPColor(p)
 if not espEnabled or not espHighlightObjects[p] then return end
 pcall(function() espHighlightObjects[p].FillColor=getColor(p) end)
end
local function startESPLoop()
