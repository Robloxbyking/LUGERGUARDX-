-- ========== FLY ==========
local function startFly()
    if flying then return end
    flying = true
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    if not hum or not torso then return end
    hum.PlatformStand = true
    
    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.P = 9e4
    flyBodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBodyGyro.cframe = torso.CFrame
    flyBodyGyro.Parent = torso
    
    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.velocity = Vector3.new(0, 0.1, 0)
    flyBodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBodyVelocity.Parent = torso
    
    local function updateFly()
        while flying and char and char.Parent do
            task.wait()
            if not flying then break end
            local moveDir = Vector3.new(flyCtrl.r - flyCtrl.l, 0, flyCtrl.f - flyCtrl.b)
            if moveDir.Magnitude > 0 then
                flySpeedValue = math.min(flySpeedValue + 0.5 + (flySpeedValue / flyMaxSpeed), flyMaxSpeed)
            elseif flySpeedValue > 0 then
                flySpeedValue = math.max(flySpeedValue - 1, 0)
            end
            local cam = workspace.CurrentCamera
            if cam then
                local cf = cam.CoordinateFrame
                if moveDir.Magnitude > 0 then
                    local vel = (cf.LookVector * (flyCtrl.f - flyCtrl.b)) + (cf.RightVector * (flyCtrl.r - flyCtrl.l))
                    flyBodyVelocity.velocity = vel * flySpeedValue
                    flyLastCtrl = {f = flyCtrl.f, b = flyCtrl.b, l = flyCtrl.l, r = flyCtrl.r}
                elseif flySpeedValue > 0 then
                    local vel = (cf.LookVector * (flyLastCtrl.f - flyLastCtrl.b)) + (cf.RightVector * (flyLastCtrl.r - flyLastCtrl.l))
                    flyBodyVelocity.velocity = vel * flySpeedValue
                else
                    flyBodyVelocity.velocity = Vector3.new(0, 0, 0)
                end
                if flyBodyGyro then flyBodyGyro.cframe = cf end
            end
        end
    end
    
    if not flyInputsConnected then
        flyInputsConnected = true
        UserInputService.InputBegan:Connect(function(inp, gp)
            if gp or not flying then return end
            local k = inp.KeyCode
            if k == Enum.KeyCode.W then flyCtrl.f = 1
            elseif k == Enum.KeyCode.S then flyCtrl.b = 1
            elseif k == Enum.KeyCode.A then flyCtrl.l = 1
            elseif k == Enum.KeyCode.D then flyCtrl.r = 1 end
        end)
        UserInputService.InputEnded:Connect(function(inp)
            if not flying then return end
            local k = inp.KeyCode
            if k == Enum.KeyCode.W then flyCtrl.f = 0
            elseif k == Enum.KeyCode.S then flyCtrl.b = 0
            elseif k == Enum.KeyCode.A then flyCtrl.l = 0
            elseif k == Enum.KeyCode.D then flyCtrl.r = 0 end
        end)
    end
    
    task.spawn(updateFly)
    if currentFlySwitchState then currentFlySwitchState(true) end
end

local function stopFly()
    if not flying then return end
    flying = false
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
    if flyBodyVelocity then flyBodyVelocity:Destroy() flyBodyVelocity = nil end
    if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
    flyCtrl = {f = 0, b = 0, l = 0, r = 0}
    flyLastCtrl = {f = 0, b = 0, l = 0, r = 0}
    flySpeedValue = flySpeed
    if currentFlySwitchState then currentFlySwitchState(false) end
end

-- ========== ОБРАБОТЧИК КЛАВИШИ Q ==========
UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    if inp.KeyCode == Enum.KeyCode.Q then
        if flying then stopFly() else startFly() end
    end
end)

-- ========== ESP ==========
local function getPlayerRole(player)
    if not player or player == LocalPlayer then return "Normal" end
    local char = player.Character
    if not char then return "Unknown" end
    if char:FindFirstChild("Knife") or char:FindFirstChild("MurdererKnife") then return "Murderer" end
    if char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") then return "Sheriff" end
    return "Normal"
end

local function getPlayerColor(player)
    local role = getPlayerRole(player)
    if role == "Murderer" then return Color3.fromRGB(255, 50, 50)
    elseif role == "Sheriff" then return Color3.fromRGB(50, 150, 255)
    else return Color3.fromRGB(150, 150, 150) end
end

local function addESPToPlayer(player)
    if not player or player == LocalPlayer or not espEnabled then return end
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    pcall(function()
        if espHighlightObjects[player] then espHighlightObjects[player]:Destroy() end
        local h = Instance.new("Highlight")
        h.Name = "LugerGuardESP"
        h.Adornee = char
        h.FillColor = getPlayerColor(player)
        h.FillTransparency = 0.7
        h.OutlineColor = Color3.fromRGB(255, 255, 255)
        h.OutlineTransparency = 0.5
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = char
        espHighlightObjects[player] = h
    end)
end

local function removeESPFromPlayer(player)
    pcall(function()
        if espHighlightObjects[player] then
            espHighlightObjects[player]:Destroy()
            espHighlightObjects[player] = nil
        end
    end)
end

local function enableESP()
    if espEnabled then return end
    espEnabled = true
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then addESPToPlayer(p) end
    end
    espPlayerAddedConnection = Players.PlayerAdded:Connect(function(p)
        if espEnabled and p ~= LocalPlayer then
            p.CharacterAdded:Connect(function() task.wait(0.5) addESPToPlayer(p) end)
            if p.Character then addESPToPlayer(p) end
        end
    end)
end

local function disableESP()
    if not espEnabled then return end
    espEnabled = false
    if espPlayerAddedConnection then espPlayerAddedConnection:Disconnect() espPlayerAddedConnection = nil end
    for _, h in pairs(espHighlightObjects) do pcall(function() h:Destroy() end) end
    espHighlightObjects = {}
end

