local function applyTheme()
    local theme = ColorThemes[currentTheme]
    if not theme then return end
    
    pcall(function()
        if topBar then 
            topBar.BackgroundColor3 = theme.bg
            if topGradient then
                topGradient.Color = ColorSequence.new(theme.gradient)
            end
        end
        if glowFrame then glowFrame.BackgroundColor3 = theme.glow end
        if xLetter then xLetter.TextColor3 = theme.text end
        if subtitleLabel then subtitleLabel.TextColor3 = theme.text end
        if blueLine then blueLine.BackgroundColor3 = theme.main end
        if rightStroke then rightStroke.Color = theme.main end
        
        if rightContent then
            rightContent.ScrollBarImageColor3 = theme.main
        end
        if leftPanel then
            leftPanel.ScrollBarImageColor3 = theme.main
        end
        
        for tab, btn in pairs(tabButtons) do
            if activeTab == tab then
                btn.TextColor3 = theme.text
                btn.BackgroundColor3 = theme.accent
            else
                btn.TextColor3 = Color3.fromRGB(160, 170, 190)
                btn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
            end
        end
        
        if contentContainer then
            local function scanAndUpdateUI(parent)
                for _, child in pairs(parent:GetChildren()) do
                    if child:IsA("TextLabel") then
                        local originalColor = child:GetAttribute("OriginalColor")
                        if not originalColor then
                            local r, g, b = child.TextColor3.R, child.TextColor3.G, child.TextColor3.B
                            if (r < 0.1 and g > 0.5 and b > 0.8) or (r < 0.1 and g > 0.3 and b > 0.5) then
                                child.TextColor3 = theme.text
                            end
                        end
                    end
                    
                    if child:IsA("TextButton") then
                        if not child:GetAttribute("KeepOriginalColor") then
                            if child.BackgroundColor3 == Color3.fromRGB(0, 100, 180) or 
                               child.BackgroundColor3 == Color3.fromRGB(0, 120, 200) then
                                child.BackgroundColor3 = theme.accent
                            end
                            child.TextColor3 = Color3.fromRGB(255, 255, 255)
                        end
                    end
                    
                    if child:IsA("TextBox") then
                        if child.BackgroundColor3 == Color3.fromRGB(25, 25, 35) then
                            local r, g, b = child.TextColor3.R, child.TextColor3.G, child.TextColor3.B
                            if (r < 0.1 and g > 0.5 and b > 0.8) or (r < 0.1 and g > 0.3 and b > 0.5) then
                                child.TextColor3 = theme.text
                            end
                        end
                    end
                    
                    scanAndUpdateUI(child)
                end
            end
            
            scanAndUpdateUI(contentContainer)
        end
        
        local teleportContainer = contentContainer and contentContainer:FindFirstChildWhichIsA("ScrollingFrame")
        if teleportContainer then
            local innerContainer = teleportContainer:FindFirstChildWhichIsA("Frame")
            if innerContainer then
                for _, playerFrame in pairs(innerContainer:GetChildren()) do
                    if playerFrame:IsA("Frame") then
                        local tpBtn = playerFrame:FindFirstChildWhichIsA("TextButton")
                        if tpBtn and tpBtn.Text == "TP" then
                            tpBtn.BackgroundColor3 = theme.accent
                        end
                    end
                end
            end
        end
    end)
end

