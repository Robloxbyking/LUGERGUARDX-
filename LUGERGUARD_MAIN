local ESP_CONFIG = {FillTransparency = 0.7, OutlineTransparency = 0.5, OutlineColor = Color3.fromRGB(255, 255, 255), DepthMode = Enum.HighlightDepthMode.AlwaysOnTop}
local ROLE_COLORS = {Murderer = Color3.fromRGB(255, 50, 50), Sheriff = Color3.fromRGB(50, 150, 255), Normal = Color3.fromRGB(150, 150, 150), Unknown = Color3.fromRGB(200, 200, 100)}
local MURDERER_WEAPONS = {"Knife", "MurdererKnife", "Dagger", "Sword", "Axe", "ButterflyKnife", "Karambit", "Machete", "Katana"}
local SHERIFF_WEAPONS = {"Gun", "Revolver", "Pistol", "Flintlock", "SheriffGun", "Handgun", "Magnum", "Colt"}

local function getPlayerRole(player)
    if not player or player == LocalPlayer then return "Normal" end
    local char = player.Character
    if not char then return "Unknown" end
    local hasMurderer = false
    local hasSheriff = false
    for _, w in pairs(MURDERER_WEAPONS) do if char:FindFirstChild(w) then hasMurderer = true break end end
    for _, w in pairs(SHERIFF_WEAPONS) do if char:FindFirstChild(w) then hasSheriff = true break end end
    local bp = player:FindFirstChild("Backpack")
    if bp then
        for _, w in pairs(MURDERER_WEAPONS) do if bp:FindFirstChild(w) then hasMurderer = true break end end
        for _, w in pairs(SHERIFF_WEAPONS) do if bp:FindFirstChild(w) then hasSheriff = true break end end
    end
    if hasSheriff then return "Sheriff"
    elseif hasMurderer then return "Murderer" end
    if char:FindFirstChild("Murderer") or char:FindFirstChild("IsMurderer") then return "Murderer" end
    if char:FindFirstChild("Sheriff") or char:FindFirstChild("IsSheriff") then return "Sheriff" end
    return "Normal"
end

local function getPlayerColor(player) return ROLE_COLORS[getPlayerRole(player)] or ROLE_COLORS.Normal end

local function addESPToPlayer(player)
    if not player or player == LocalPlayer or not espEnabled then return end
    if not player.Character then return end
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    if espHighlightObjects[player] then pcall(function() espHighlightObjects[player]:Destroy() end) end
    local h = Instance.new("Highlight")
    h.Name = "LugerGuardESP"
    h.Adornee = char
    h.FillColor = getPlayerColor(player)
    h.FillTransparency = ESP_CONFIG.FillTransparency
    h.OutlineColor = ESP_CONFIG.OutlineColor
    h.OutlineTransparency = ESP_CONFIG.OutlineTransparency
    h.DepthMode = ESP_CONFIG.DepthMode
    h.Parent = char
    espHighlightObjects[player] = h
    if not espWeaponConnections[player] then
        espWeaponConnections[player] = true
        local function onWeaponAdded(weapon)
            if weapon:IsA("Tool") then
                if espHighlightObjects[player] then pcall(function() espHighlightObjects[player].FillColor = getPlayerColor(player) end) end
                if nameTagsEnabled then
                    local tag = nameTagObjects[player]
                    if tag then
                        local lbl = tag:FindFirstChild("NameLabel")
                        if lbl then lbl.TextColor3 = getPlayerColor(player) end
                    end
                end
            end
        end
        if player.Character then
            player.Character.ChildAdded:Connect(onWeaponAdded)
        else
            player.CharacterAdded:Connect(function(c) task.wait(0.5) c.ChildAdded:Connect(onWeaponAdded) addESPToPlayer(player) end)
        end
    end
end

local function removeESPFromPlayer(player)
    if espHighlightObjects[player] then pcall(function() espHighlightObjects[player]:Destroy() end) espHighlightObjects[player] = nil end
end

local function updateESPColor(player)
    if not espEnabled or not espHighlightObjects[player] then return end
    pcall(function() espHighlightObjects[player].FillColor = getPlayerColor(player) end)
end

local function startESPColorUpdateLoop()
    if espColorUpdateLoop then return end
    espColorUpdateLoop = task.spawn(function()
        while espEnabled do
            for p, _ in pairs(espHighlightObjects) do if p and p.Character then updateESPColor(p) end end
            task.wait(0.3)
        end
        espColorUpdateLoop = nil
    end)
end

local function enableESP()
    if espEnabled then return end
    espEnabled = true
    for _, p in pairs(Players:GetPlayers()) do if p ~= LocalPlayer then addESPToPlayer(p) end end
    startESPColorUpdateLoop()
    espPlayerAddedConnection = Players.PlayerAdded:Connect(function(p)
        if espEnabled and p ~= LocalPlayer then
            if p.Character then addESPToPlayer(p) else p.CharacterAdded:Once(function() task.wait(0.5) addESPToPlayer(p) end) end
        end
    end)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not espHighlightObjects[p] then
            if p.Character then addESPToPlayer(p) else p.CharacterAdded:Once(function() task.wait(0.5) addESPToPlayer(p) end) end
        end
    end
end

local function disableESP()
    if not espEnabled then return end
    espEnabled = false
    if espPlayerAddedConnection then espPlayerAddedConnection:Disconnect() espPlayerAddedConnection = nil end
    for _, h in pairs(espHighlightObjects) do pcall(function() h:Destroy() end) end
    espHighlightObjects = {}
    for p, _ in pairs(espWeaponConnections) do espWeaponConnections[p] = nil end
end

