local function applyLanguage(lang)
    currentLang = lang
    langChoiceFrame:Destroy()
    
    local sub = screenGui:FindFirstChild("SubtitleLabel")
    if sub then
        sub.Text = "Premium Murder Mystery 2 Script"
    end
    
    for tab, btn in pairs(tabButtons) do
        if lang == "ru" then
            if tab == "Main" then btn.Text = "Главная"
            elseif tab == "Visual" then btn.Text = "Визуал"
            elseif tab == "Players" then btn.Text = "Игроки"
            elseif tab == "Teleport" then btn.Text = "Телепорт"
            elseif tab == "ESP" then btn.Text = "ESP"
            elseif tab == "Feedback" then btn.Text = "Отзывы"
            elseif tab == "Settings" then btn.Text = "Настройки"
            end
        else
            if tab == "Main" then btn.Text = "Main"
            elseif tab == "Visual" then btn.Text = "Visual"
            elseif tab == "Players" then btn.Text = "Players"
            elseif tab == "Teleport" then btn.Text = "Teleport"
