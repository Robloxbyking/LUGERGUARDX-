            Instance.new("UICorner").CornerRadius = UDim.new(0, 6).Parent = playerFrame
            
            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, -70, 1, 0)
            nameLabel.Position = UDim2.new(0, 12, 0, 0)
            nameLabel.Text = player.Name
            nameLabel.TextColor3 = Color3.fromRGB(210, 215, 225)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Font = Enum.Font.Gotham
            nameLabel.TextSize = 13
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.Parent = playerFrame
            
            local teleportBtn = Instance.new("TextButton")
            teleportBtn.Size = UDim2.new(0, 55, 0, 26)
            teleportBtn.Position = UDim2.new(1, -62, 0, 4.5)
            teleportBtn.Text = "TP"
            teleportBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            teleportBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 180)
            teleportBtn.BackgroundTransparency = 0.2
            teleportBtn.BorderSizePixel = 0
            teleportBtn.Font = Enum.Font.GothamBold
            teleportBtn.TextSize = 12
            teleportBtn.Parent = playerFrame
            Instance.new("UICorner").CornerRadius = UDim.new(0, 4).Parent = teleportBtn
            
            teleportBtn.MouseEnter:Connect(function() teleportBtn.BackgroundTransparency = 0.4 teleportBtn.TextColor3 = Color3.fromRGB(0, 200, 255) end)
            teleportBtn.MouseLeave:Connect(function() teleportBtn.BackgroundTransparency = 0.2 teleportBtn.TextColor3 = Color3.fromRGB(255, 255, 255) end)
            teleportBtn.MouseButton1Click:Connect(function()
                local success = teleportToPlayer(player)
                if statusLabel then
                    if success then statusLabel.Text = (currentLang == "ru") and "✓ Телепортирован к " .. player.Name or "✓ Teleported to " .. player.Name
                    else statusLabel.Text = (currentLang == "ru") and "✗ Не удалось телепортироваться к " .. player.Name or "✗ Failed to teleport to " .. player.Name end
                    statusLabel.TextColor3 = success and Color3.fromRGB(100, 200, 100) or Color3.fromRGB(255, 120, 120)
                    task.wait(2)
                    statusLabel.Text = ""
                end
            end)
            yOffset = yOffset + 40
        end
    end
    if playerCount == 0 then
        local emptyLabel = Instance.new("TextLabel")
        emptyLabel.Size = UDim2.new(1, -20, 0, 35)
        emptyLabel.Position = UDim2.new(0, 0, 0, 0)
        emptyLabel.Text = (currentLang == "ru") and "Нет других игроков на сервере" or "No other players on server"
        emptyLabel.TextColor3 = Color3.fromRGB(180, 180, 200)
        emptyLabel.BackgroundTransparency = 1
        emptyLabel.Font = Enum.Font.Gotham
        emptyLabel.TextSize = 12
        emptyLabel.Parent = container
        yOffset = 40
    end
    container.Size = UDim2.new(1, 0, 0, yOffset + 10)
end

