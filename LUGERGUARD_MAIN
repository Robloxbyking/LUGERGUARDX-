local function updateElementColor(element, colorType, theme)
    if not element or not theme then return end
    
    pcall(function()
        if colorType == "text" then
            if element:IsA("TextLabel") or element:IsA("TextButton") or element:IsA("TextBox") then
                if element:IsA("TextButton") then
                    if not element:GetAttribute("KeepOriginalColor") then
                        element.TextColor3 = theme.text
                    end
                else
                    element.TextColor3 = theme.text
                end
            end
        elseif colorType == "background" then
            if element:IsA("Frame") or element:IsA("TextButton") then
                if not element:GetAttribute("NoTheme") then
                    element.BackgroundColor3 = theme.bg
                end
            end
        elseif colorType == "accent" then
            if element:IsA("Frame") or element:IsA("TextButton") then
                element.BackgroundColor3 = theme.accent
            end
        elseif colorType == "main" then
            if element:IsA("Frame") then
                element.BackgroundColor3 = theme.main
            end
        end
    end)
end

